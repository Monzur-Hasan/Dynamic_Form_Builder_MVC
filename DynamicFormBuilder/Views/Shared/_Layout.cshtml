<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Dynamic Form Builder</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <link rel="stylesheet" href="~/css/site.css" />
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/css/datatables.bootstrap5.min.css" rel="stylesheet" />

    <script src="~/lib/bootstrap/js/jquery-3.7.1.min.js"></script>
    <script src="~/lib/bootstrap/js/jquery.datatables.min.js"></script>
    <script src="~/lib/bootstrap/js/datatables.bootstrap5.min.js"></script>
    <script src="~/lib/bootstrap/js/sweetalert2@11.js"></script>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand" href="/" style="font-weight:bold">Dynamic Form Builder</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topNav" aria-controls="topNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="topNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item" style="font-weight:bold"><a class="nav-link" href="/">Forms</a></li>
                    <li class="nav-item" style="font-weight:bold"><a class="nav-link" href="/Form/Create">Create Form</a></li>
                    <li class="nav-item" style="font-weight:bold"><a class="nav-link" href="/OptionSet">Option Sets</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav id="sidebarMenu" class="col-md-2 col-lg-2 d-md-block sidebar collapse navbar navbar-dark bg-primary flex-column mt-0">
                <div class="position-sticky pt-3">
                    <ul class="nav flex-column">
                        <li class="nav-item"><a class="nav-link text-white" href="/"><i class="bi bi-list"></i> Forms</a></li>
                        <li class="nav-item"><a class="nav-link text-white" href="/Form/Create"><i class="bi bi-plus-circle"></i> Create Form</a></li>
                        <li class="nav-item"><a class="nav-link text-white" href="/OptionSet"><i class="bi bi-gear"></i> Option Sets Admin</a></li>
                    </ul>
                </div>
            </nav>

            <!-- Main content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                @RenderBody()
                <footer class="pt-4">
                    <hr />
                    <small class="text-muted">© @DateTime.Now.Year — Dynamic Form Builder</small>
                </footer>
            </main>
        </div>
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/form-builder.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
