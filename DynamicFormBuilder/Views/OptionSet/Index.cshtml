@{
    ViewData["Title"] = "Option Sets";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Option Sets</h3>
    <a class="btn btn-success" href="/OptionSet/Create">Create New Option Set</a>
</div>

<div class="card">
    <div class="card-body">

        <table id="optionSetTable" class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Values</th>
                    <th>Action</th>
                </tr>
            </thead>
        </table>

    </div>
</div>

@section Scripts {
    <script>
        $(function () {

            $('#optionSetTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: "/OptionSet/LoadData",
                    type: "POST"
                },
                columns: [
                    // { data: "optionId" },
                    { data: "name" },
                    {
                        data: "optionId",
                        render: function (id) {
                            return `<a class="btn btn-sm btn-outline-primary" href="/OptionSet/Values/${id}">Manage</a>`;
                        }
                    },
                    {
                        data: "optionId",
                        render: function (id) {
                            return `
                                <a class="btn btn-sm btn-primary me-1" href="/OptionSet/Edit/${id}">Edit</a>
                                <a class="btn btn-sm btn-danger" href="/OptionSet/Delete/${id}"
                                   onclick="return confirm('Delete option set?')">Delete</a>`;
                        }
                    }
                ],
                lengthMenu: [10, 25, 50],
                order: [[0, "desc"]]
            });

        });
    </script>
}
