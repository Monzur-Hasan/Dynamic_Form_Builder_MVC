@{
    ViewData["Title"] = "Create Option Set";
}

<div class="card">
    <div class="card-body">
        <h4>Create Option Set</h4>

        <form id="optionSetForm">
            <div class="mb-3">
                <label class="form-label">Name</label> <span class="text-danger">*</span>
                <input name="name" id="name" class="form-control" placeholder="Enter option set name" />
                <div class="invalid-feedback">Option Set name is required.</div>
            </div>

            <button class="btn btn-primary" id="btnSave">Save</button>
            <a href="/OptionSet" class="btn btn-secondary ms-2"><i class="bi bi-arrow-left"></i> Back to List</a>
        </form>
    </div>
</div>

<script src="~/lib/bootstrap/js/sweetalert2@11.js"></script>

@section Scripts {
    <script>
        $(function () {

            $("#btnSave").on("click", function (e) {
                e.preventDefault();

                let name = $("#name").val().trim();
                $("#name").removeClass("is-invalid");
                
                if (!name) {
                    $("#name").addClass("is-invalid");
                    return;
                }
                $.ajax({
                    url: "/OptionSet/Create",
                    method: "POST",
                    data: { name: name },
                    success: function () {
                        Swal.fire({
                            icon: "success",
                            title: "Saved!",
                            text: "Option Set created successfully.",
                            confirmButtonText: "OK"
                        }).then(() => {
                            window.location.href = "/OptionSet";
                        });
                    },
                    error: function (xhr) {
                        Swal.fire("Error", xhr.responseText || "Save failed.", "error");
                    }
                });
            });

        });
    </script>
}
